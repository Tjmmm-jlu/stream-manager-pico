  steps:
  - id: forceps_transfer
    instruction: "\u4F7F\u7528\u954A\u5B50\u5939\u53D6\u7C97\u786B\u9178\u94DC\uFF0C\u5E76\u8F6C\u79FB\u5230\u7A7A\u70E7\u676F\u3002"
    target: {fileID: 779125364}
    completionAction: transfer_copper_sulfate
  - id: graduated_cylinder
    instruction: "\u53CC\u624B\u5206\u522B\u6301\u91CF\u7B52\u548C\u6C34\u6E90\u5BB9\u5668\uFF0C\u91CF\u53D6
      100 mL \u6E05\u6C34\uFF08\u5141\u8BB8\u8BEF\u5DEE 10 mL\uFF09\u3002"
    target: {fileID: 4256008534895999338}
    completionAction: measure_water
  - id: beaker
    instruction: "\u53CC\u624B\u6301\u91CF\u7B52\u548C\u70E7\u676F\uFF0C\u52A0\u5165
      100 mL \u6C34\uFF1B\u968F\u540E\u6301\u70E7\u676F\u548C\u73BB\u7483\u68D2\u6405\u62CC\u6EB6\u89E3\u3002"
    target: {fileID: 4125993489218426560}
    completionAction: dissolve_copper_sulfate
  - id: glass_funnel
    instruction: "\u5C06\u6F0F\u6597\u5B89\u88C5\u5728\u94C1\u67B6\u53F0\u652F\u6491\u73AF\u4E0A\uFF0C\u63A5\u6536\u70E7\u676F\u653E\u5165\u5E95\u5EA7\u5B9A\u4F4D\u533A\uFF1B\u53CC\u624B\u6301\u539F\u70E7\u676F\u548C\u73BB\u7483\u68D2\u5F15\u6D41\u8FC7\u6EE4\uFF0C\u5B8C\u6210\u540E\u53D6\u51FA\u63A5\u6536\u70E7\u676F\u3002"
    target: {fileID: 2009214119}
    completionAction: filter_copper_sulfate
  - id: china_dish
    instruction: "\u53CC\u624B\u6301\u63A5\u6536\u70E7\u676F\u548C\u84B8\u53D1\u76BF\uFF0C\u5C06\u84DD\u8272\u6EE4\u6DB2\u5012\u5165\u84B8\u53D1\u76BF\u3002"
    target: {fileID: 1923118834}
    completionAction: transfer_filtrate
  - id: heating_assembly
    instruction: "\u53D6\u4E0B\u6F0F\u6597\uFF0C\u5C06\u84B8\u53D1\u76BF\u548C\u9152\u7CBE\u706F\u5B89\u88C5\u5230\u94C1\u67B6\u53F0\u3002"
    target: {fileID: 700000001}
    completionAction: assemble_heating
  - id: spirit_lamp
    instruction: "\u53D6\u4E0B\u706F\u5E3D\uFF0C\u7528\u957F\u67C4\u70B9\u706B\u5668\u70B9\u71C3\u9152\u7CBE\u706F\uFF1B\u6D53\u7F29\u5B8C\u6210\u540E\u76D6\u5E3D\u706D\u706B\uFF0C\u7B49\u5F85
      5 \u79D2\u7ED3\u6676\u3002"
